NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://ai_study_mentor:local-development-only-password@127.0.0.1:54329/ai_study_mentor_dev
TEST_DATABASE_URL=postgres://ai_study_mentor:local-development-only-password@127.0.0.1:54329/ai_study_mentor_test
JWT_ACCESS_SECRET=replace-with-a-minimum-32-character-development-secret
JWT_ISSUER=ai-study-mentor-api
JWT_AUDIENCE=ai-study-mentor-clients
WEB_ORIGINS=http://localhost:3000
# Production and staging must keep this true. Development/test may set it false
# only together with the explicit loopback exception below and loopback origins.
REFRESH_COOKIE_SECURE=true
ALLOW_INSECURE_LOOPBACK_REFRESH_COOKIE=false
# Leave unset for a host-only refresh cookie. Never use a wildcard domain.
# REFRESH_COOKIE_DOMAIN=

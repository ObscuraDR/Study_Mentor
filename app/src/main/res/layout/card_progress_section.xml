<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/progress_card"
    style="@style/StudyMentorCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/progress_section_icon"
                android:layout_width="@dimen/section_icon_size"
                android:layout_height="@dimen/section_icon_size"
                android:src="@drawable/ic_trending_up"
                app:tint="?attr/colorPrimary"
                android:contentDescription="@null" />

            <TextView
                style="@style/TextAppearance.TitleMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:text="@string/progress_title"
                android:textColor="?android:attr/textColorPrimary"
                android:accessibilityHeading="true" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/progress_hero_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:orientation="horizontal"
            android:gravity="bottom">

            <TextView
                android:id="@+id/progress_total_xp"
                style="@style/TextAppearance.HeadlineMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="36sp"
                android:textColor="?android:attr/textColorPrimary"
                android:text="@string/value_placeholder" />

            <TextView
                style="@style/TextAppearance.BodyMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:paddingBottom="2dp"
                android:text="@string/progress_total_xp"
                android:textColor="@color/light_text_secondary" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/completion_bar"
            style="?android:progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/completion_bar_height"
            android:layout_marginTop="@dimen/spacing_sm"
            android:max="1000" />

        <TextView
            android:id="@+id/completion_percentage"
            style="@style/TextAppearance.LabelMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:textColor="@color/light_text_secondary"
            android:text="@string/progress_percentage" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:orientation="horizontal"
            android:gravity="center">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <TextView
                    android:id="@+id/stat_lessons"
                    style="@style/TextAppearance.TitleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?android:attr/textColorPrimary" />
                <TextView
                    style="@style/TextAppearance.LabelSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/progress_lessons"
                    android:textColor="@color/light_text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <TextView
                    android:id="@+id/stat_topics"
                    style="@style/TextAppearance.TitleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?android:attr/textColorPrimary" />
                <TextView
                    style="@style/TextAppearance.LabelSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/progress_topics"
                    android:textColor="@color/light_text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <TextView
                    android:id="@+id/stat_subjects"
                    style="@style/TextAppearance.TitleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?android:attr/textColorPrimary" />
                <TextView
                    style="@style/TextAppearance.LabelSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/progress_subjects"
                    android:textColor="@color/light_text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <TextView
                    android:id="@+id/stat_study_time"
                    style="@style/TextAppearance.TitleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?android:attr/textColorPrimary" />
                <TextView
                    style="@style/TextAppearance.LabelSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/progress_study_time"
                    android:textColor="@color/light_text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/progress_error_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:id="@+id/progress_error_text"
                style="@style/TextAppearance.BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/feedback_error" />
            <TextView
                android:id="@+id/progress_error_ref"
                style="@style/TextAppearance.LabelSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/light_text_secondary" />
            <Button
                android:id="@+id/progress_retry_button"
                style="@style/StudyMentorButton.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/action_retry" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress_loading"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="@dimen/spacing_sm"
            android:indeterminate="true"
            android:visibility="gone" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

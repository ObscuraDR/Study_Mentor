<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="@dimen/spacing_md">
    <com.google.android.material.card.MaterialCardView android:id="@+id/progress_row" style="@style/StudyMentorCard" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardElevation="4dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView style="@style/TextAppearance.LabelMedium" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/flashcards_progress_label" android:textColor="?attr/colorPrimary" />
            <ProgressBar android:id="@+id/progress_bar" style="?android:progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="@dimen/spacing_sm" android:max="100" />
            <TextView android:id="@+id/progress_text" style="@style/TextAppearance.BodyMedium" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm" android:textColor="@color/light_text_secondary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="@dimen/spacing_md">
        <com.google.android.material.card.MaterialCardView android:id="@+id/flashcard" android:layout_width="match_parent" android:layout_height="match_parent" android:clickable="true" android:contentDescription="@string/flashcards_reveal" android:focusable="true" app:cardCornerRadius="16dp" app:cardElevation="4dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="@dimen/spacing_lg">
                <TextView android:id="@+id/card_side_label" style="@style/TextAppearance.LabelMedium" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="?attr/colorPrimary" />
                <TextView android:id="@+id/card_text" style="@style/TextAppearance.HeadlineSmall" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm" android:accessibilityHeading="true" android:gravity="center" android:textAlignment="center" android:textColor="?attr/colorOnSurface" />
                <TextView android:id="@+id/card_state" style="@style/TextAppearance.BodyMedium" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_md" android:textColor="@color/light_text_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>
    <LinearLayout android:id="@+id/answer_buttons" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_md" android:orientation="horizontal" android:visibility="gone">
        <Button android:id="@+id/known_button" style="@style/StudyMentorButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/flashcards_known" />
        <Button android:id="@+id/forgot_button" style="@style/StudyMentorButton.Outlined" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="@dimen/spacing_sm" android:text="@string/flashcards_forgot" />
    </LinearLayout>
    <Button android:id="@+id/reveal_button" style="@style/StudyMentorButton.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_md" android:text="@string/flashcards_reveal" />
    <LinearLayout android:id="@+id/done_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_md" android:orientation="vertical" android:gravity="center" android:visibility="gone">
        <TextView style="@style/TextAppearance.HeadlineMedium" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/flashcards_session_done" android:textColor="?android:attr/textColorPrimary" android:accessibilityHeading="true" />
        <TextView android:id="@+id/done_score" style="@style/TextAppearance.BodyLarge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm" android:textColor="?android:attr/textColorPrimary" />
    </LinearLayout>
    <ProgressBar android:id="@+id/loading" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center" android:contentDescription="@string/state_loading" android:visibility="gone" />
    <LinearLayout android:id="@+id/error_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:padding="@dimen/spacing_lg" android:visibility="gone">
        <TextView style="@style/TextAppearance.TitleMedium" android:layout_width="wrap_content" android:layout_height="wrap_content" android:accessibilityHeading="true" android:text="@string/error_generic_title" android:textColor="?attr/colorOnSurface" />
        <TextView style="@style/TextAppearance.BodyMedium" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm" android:gravity="center" android:text="@string/error_generic_body" android:textColor="@color/light_text_secondary" />
        <Button android:id="@+id/error_retry" style="@style/StudyMentorButton.Outlined" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_md" android:text="@string/action_retry" />
    </LinearLayout>
</LinearLayout>

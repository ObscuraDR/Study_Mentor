<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/primary_action_card"
    style="@style/StudyMentorCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/section_icon"
                android:layout_width="@dimen/section_icon_size"
                android:layout_height="@dimen/section_icon_size"
                android:src="@drawable/ic_menu_book"
                app:tint="?attr/colorPrimary"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/section_heading"
                style="@style/TextAppearance.TitleMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:layout_weight="1"
                android:textColor="?android:attr/textColorPrimary"
                android:accessibilityHeading="true"
                android:text="@string/home_continue_learning_heading" />
        </LinearLayout>

        <!-- Content: lesson title as tappable list row -->
        <LinearLayout
            android:id="@+id/lesson_action_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:minHeight="@dimen/touch_list_row"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/lesson_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_menu_book"
                app:tint="?attr/colorPrimary"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/lesson_title"
                style="@style/TextAppearance.TitleMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_weight="1"
                android:textColor="?android:attr/textColorPrimary"
                android:maxLines="2"
                android:ellipsize="end" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/light_text_secondary"
                android:contentDescription="@null" />
        </LinearLayout>

        <!-- Loading (hidden) -->
        <LinearLayout
            android:id="@+id/action_loading_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:gravity="center_vertical"
            android:visibility="gone">
            <ProgressBar
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:indeterminate="true" />
            <TextView
                style="@style/TextAppearance.BodyMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:text="@string/state_loading"
                android:textColor="@color/light_text_secondary" />
        </LinearLayout>

        <!-- Error (hidden) -->
        <LinearLayout
            android:id="@+id/action_error_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:id="@+id/action_error_text"
                style="@style/TextAppearance.BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/feedback_error" />
            <TextView
                android:id="@+id/action_error_ref"
                style="@style/TextAppearance.LabelSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/light_text_secondary" />
            <Button
                android:id="@+id/action_retry_button"
                style="@style/StudyMentorButton.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/action_retry" />
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <!-- Profile card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/StudyMentorCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="4dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    style="@style/TextAppearance.HeadlineMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_title"
                    android:textColor="?android:attr/textColorPrimary"
                    android:accessibilityHeading="true" />
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/display_name_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:hint="@string/profile_field_display_name">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/display_name_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:hint="@string/profile_field_email">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/email_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:enabled="false"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    style="@style/TextAppearance.LabelSmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="@string/profile_email_readonly"
                    android:textColor="@color/light_text_secondary" />
                <TextView
                    style="@style/TextAppearance.LabelMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/profile_field_education_level"
                    android:textColor="?attr/colorOnSurface" />
                <Spinner
                    android:id="@+id/education_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:contentDescription="@string/profile_field_education_level" />
                <Button
                    android:id="@+id/save_profile_button"
                    style="@style/StudyMentorButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/profile_action_save" />
                <TextView
                    android:id="@+id/profile_saved_text"
                    style="@style/TextAppearance.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:textColor="@color/feedback_success"
                    android:visibility="gone"
                    android:text="@string/profile_saved" />
                <Button
                    android:id="@+id/reload_button"
                    style="@style/StudyMentorButton.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/action_reload"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Settings -->
        <com.google.android.material.card.MaterialCardView
            style="@style/StudyMentorCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    style="@style/TextAppearance.TitleMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_title"
                    android:textColor="?android:attr/textColorPrimary"
                    android:accessibilityHeading="true" />
                <TextView
                    style="@style/TextAppearance.LabelMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/settings_field_locale"
                    android:textColor="?attr/colorOnSurface" />
                <Spinner
                    android:id="@+id/locale_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:contentDescription="@string/settings_field_locale" />
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/daily_goal_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:hint="@string/settings_field_daily_goal">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/daily_goal_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
                <Button
                    android:id="@+id/save_settings_button"
                    style="@style/StudyMentorButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/action_save" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/StudyMentorCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView style="@style/TextAppearance.TitleMedium" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityHeading="true" android:text="@string/reminder_title" android:textColor="?attr/colorOnSurface" />
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/reminder_switch" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm" android:minHeight="48dp" android:text="@string/reminder_daily_label" />
                <TextView style="@style/TextAppearance.BodyMedium" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/reminder_daily_hint" android:textColor="@color/light_text_secondary" />
                <Button android:id="@+id/reminder_time_button" style="@style/StudyMentorButton.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm" android:text="@string/reminder_pick_time" />
                <TextView android:id="@+id/reminder_permission_note" style="@style/TextAppearance.BodyMedium" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm" android:text="@string/reminder_permission_note" android:textColor="@color/feedback_warning" android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Sign out -->
        <Button
            android:id="@+id/sign_out_button"
            style="@style/StudyMentorButton.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/action_sign_out" />
    </LinearLayout>
</ScrollView>

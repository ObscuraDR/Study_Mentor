<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Context line -->
    <TextView
        android:id="@+id/context_line"
        style="@style/TextAppearance.BodyLarge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_md"
        android:paddingVertical="@dimen/spacing_sm"
        android:text="@string/catalog_subjects_context"
        android:textColor="@color/light_text_secondary" />

    <!-- Campaign Map button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_md"
        android:layout_marginBottom="@dimen/spacing_sm"
        android:orientation="horizontal">

        <Button
            android:id="@+id/campaign_entry_button"
            style="@style/StudyMentorButton.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/campaign_entry" />
    </LinearLayout>

    <!-- Progress/State container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- SwipeRefreshLayout for pull-to-refresh -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/subjects_recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="@dimen/spacing_md" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- Loading state -->
        <ProgressBar
            android:id="@+id/loading_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Empty state -->
        <LinearLayout
            android:id="@+id/empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md"
            android:visibility="gone">
            <TextView
                android:id="@+id/empty_title"
                style="@style/TextAppearance.TitleMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/catalog_subjects_empty_title"
                android:textColor="?android:attr/textColorPrimary"
                android:gravity="center" />
            <TextView
                android:id="@+id/empty_description"
                style="@style/TextAppearance.BodyMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/catalog_subjects_empty_body"
                android:textColor="@color/light_text_secondary"
                android:gravity="center" />
        </LinearLayout>

        <!-- Error state -->
        <LinearLayout
            android:id="@+id/error_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md"
            android:visibility="gone">
            <TextView
                android:id="@+id/error_title"
                style="@style/TextAppearance.TitleMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorPrimary"
                android:gravity="center" />
            <TextView
                android:id="@+id/error_description"
                style="@style/TextAppearance.BodyMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:textColor="@color/light_text_secondary"
                android:gravity="center" />
            <TextView
                android:id="@+id/error_reference"
                style="@style/TextAppearance.LabelSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textColor="@color/light_text_secondary"
                android:visibility="gone" />
            <Button
                android:id="@+id/error_retry_button"
                style="@style/StudyMentorButton.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/action_retry" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>

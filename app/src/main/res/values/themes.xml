<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Light theme based on Material 3 color tokens from Color.kt (Palette).
      Uses Material Components DayNight theme for dark mode support.
    -->
    <style name="Theme.StudyMentor" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_base</item>
        <item name="colorPrimaryVariant">@color/primary_strong</item>
        <item name="colorPrimaryDark">@color/primary_strong</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/secondary_base</item>
        <item name="colorSecondaryVariant">@color/secondary_strong</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/light_canvas</item>
        <item name="colorSurface">@color/light_surface</item>
        <item name="colorOnSurface">@color/light_text_primary</item>
        <item name="colorError">@color/feedback_error</item>
        <item name="colorOnError">@color/white</item>
        <item name="android:statusBarColor">@color/primary_strong</item>
        <item name="android:navigationBarColor">@color/black</item>
    </style>

    <!-- Text appearances — mirrors StudyMentorTypography from Type.kt -->
    <style name="TextAppearance.HeadlineMedium" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">24sp</item>
        <item name="android:lineSpacingExtra">7sp</item>
    </style>

    <style name="TextAppearance.HeadlineSmall" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">20sp</item>
        <item name="android:lineSpacingExtra">4sp</item>
    </style>

    <style name="TextAppearance.TitleMedium" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">6sp</item>
    </style>

    <style name="TextAppearance.TitleSmall" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">6sp</item>
    </style>

    <style name="TextAppearance.BodyLarge" parent="TextAppearance.MaterialComponents.Body1">
        <item name="fontFamily">sans-serif</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">9sp</item>
    </style>

    <style name="TextAppearance.BodyMedium" parent="TextAppearance.MaterialComponents.Body2">
        <item name="fontFamily">sans-serif</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">7sp</item>
    </style>

    <style name="TextAppearance.LabelMedium" parent="TextAppearance.MaterialComponents.Button">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">5sp</item>
    </style>

    <style name="TextAppearance.LabelSmall" parent="TextAppearance.MaterialComponents.Caption">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingExtra">5sp</item>
    </style>

    <!-- Card style matching StudyMentorCard -->
    <style name="StudyMentorCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardElevation">2dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardBackgroundColor">@color/light_surface</item>
        <item name="contentPadding">16dp</item>
    </style>

    <!-- Button style matching StudyMentorButton primary variant -->
    <style name="StudyMentorButton" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAppearance">@style/TextAppearance.LabelMedium</item>
    </style>

    <style name="StudyMentorButton.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAppearance">@style/TextAppearance.LabelMedium</item>
    </style>

    <!-- Divider -->
    <style name="StudyMentorDivider">
        <item name="android:layout_height">1dp</item>
        <item name="android:background">?android:attr/listDivider</item>
    </style>
</resources>

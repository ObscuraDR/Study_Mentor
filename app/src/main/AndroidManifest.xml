<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".StudyMentorApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StudyMentor"
        android:usesCleartextTraffic="false">

        <!-- Phase 4 Java Activities -->

        <!-- Splash -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.StudyMentor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Onboarding -->
        <activity
            android:name=".ui.onboarding.OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.StudyMentor" />

        <!-- Auth / Forgot Password -->
        <activity
            android:name=".ui.auth.AuthActivity"
            android:exported="false"
            android:theme="@style/Theme.StudyMentor"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.forgotpassword.ForgotPasswordActivity"
            android:exported="false"
            android:theme="@style/Theme.StudyMentor" />

        <!-- Main shell with bottom nav -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.StudyMentor"
            android:windowSoftInputMode="adjustResize" />

        <!-- Lesson detail -->
        <activity
            android:name=".ui.lesson.LessonDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.StudyMentor" />

        <!-- Topics (transient wrapper) -->
        <activity
            android:name=".ui.learning.TopicsActivity"
            android:exported="false"
            android:theme="@style/Theme.StudyMentor" />

        <!-- Quiz -->
        <activity
            android:name=".ui.quiz.QuizListActivity"
            android:exported="false"
            android:theme="@style/Theme.StudyMentor" />

        <activity
            android:name=".ui.quiz.QuizAttemptActivity"
            android:exported="false"
            android:theme="@style/Theme.StudyMentor" />

        <activity
            android:name=".ui.quiz.WrongAnswerActivity"
            android:exported="false"
            android:theme="@style/Theme.StudyMentor" />

        <!-- Flashcard -->
        <activity
            android:name=".ui.flashcards.FlashcardListActivity"
            android:exported="false"
            android:theme="@style/Theme.StudyMentor" />

        <activity
            android:name=".ui.flashcards.FlashcardReviewActivity"
            android:exported="false"
            android:theme="@style/Theme.StudyMentor" />

        <!-- Tutor Chat -->
        <activity
            android:name=".ui.tutor.TutorChatActivity"
            android:exported="false"
            android:theme="@style/Theme.StudyMentor"
            android:windowSoftInputMode="adjustResize" />

        <!-- Campaign Map -->
        <activity
            android:name=".ui.campaign.CampaignMapActivity"
            android:exported="false"
            android:theme="@style/Theme.StudyMentor" />

        <activity
            android:name=".ui.campaign.BossChallengeActivity"
            android:exported="false"
            android:theme="@style/Theme.StudyMentor" />

        <activity
            android:name=".ui.campaign.EconomyActivity"
            android:exported="false"
            android:theme="@style/Theme.StudyMentor" />

        <!-- Original MainActivity (Compose) — kept for Phase 5 comparison -->
    </application>

</manifest>
